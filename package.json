{
  "name": "loki",
  "version": "1.0.0-rc.3",
  "description": "Agent Loki V1 local-first macOS application and optional legacy Discord runtime",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/bot.js",
    "dev": "tsx src/bot.ts",
    "register": "tsx src/scripts/register.ts",
    "backfill": "tsx src/scripts/backfill.ts",
    "test": "vitest run",
    "audit": "node --import tsx src/scripts/audit.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "discord.js": "^14.18.0",
    "dotenv": "^16.4.7",
    "js-yaml": "^4.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.13.4",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vitest": "^2.1.8"
  }
}
